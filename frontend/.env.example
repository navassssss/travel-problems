# ============================================================
# Frontend Environment Variables (Vite + React)
# ============================================================
# NOTE: In Vite, only variables prefixed with VITE_ are exposed
# to the client browser code via import.meta.env.VITE_*
#
# Local Development:
# VITE_API_URL=http://localhost:3000
#
# Production (Configure this in Vercel Dashboard):
# VITE_API_URL=https://<your-render-backend-service>.onrender.com
# VITE_APP_NAME=Your Project
# ============================================================

# Local development defaults to http://localhost:3000 when unset.
